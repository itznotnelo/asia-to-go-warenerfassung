// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitType {
  piece
  weight
  volume
}

enum ContentUnit {
  g
  kg
  ml
  l
  stk
}

enum StorageType {
  ambient
  chilled
  frozen
}

enum DataSource {
  openfoodfacts
  manual
  ai_extracted
}

enum ImageType {
  front
  ingredients
  nutrition
  other
}

enum ScanResult {
  existing_product
  off_hit
  off_miss
}

enum ShopOrderStatus {
  received
  picked
  ready
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  parentId  String?
  parent    Category? @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id            String      @id @default(cuid())
  ean           String?     @unique
  sku           String      @unique
  nameDe        String
  nameOriginal  String?
  nameEn        String?
  brand         String?
  originCountry String?
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceRappen   Int
  vatRate       Decimal     @default(2.6) @db.Decimal(3, 1)
  unitType      UnitType
  contentAmount Decimal?    @db.Decimal(10, 3)
  contentUnit   ContentUnit?
  storageType   StorageType
  ingredientsDe String?
  allergens     String[]    @default([])
  nutrition     Json?
  isAvailable   Boolean     @default(true)
  stockQty      Int?
  dataSource    DataSource
  // Computed in application code (not a generated DB column) whenever a
  // product is written — see lib/pricing.ts and the swiss-food-compliance
  // skill for the required-field list. The shop must not display a product
  // where this is false.
  dataComplete  Boolean     @default(false)
  notes         String?
  images        ProductImage[]
  scanLogs      ScanLog[]
  orderItems    ShopOrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([categoryId])
  @@index([nameOriginal])
  @@index([isAvailable])
  @@index([dataComplete])
}

model ProductImage {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type              ImageType
  path              String
  width             Int
  height            Int
  sortOrder         Int       @default(0)
  sourceAttribution String?
  // Set once this image has been pushed to the Cloudflare backend's R2
  // bucket (ticket #1369) — null means "not published yet", not "failed";
  // see lib/sync/build-ops.ts's imagesReadyForSync.
  r2Key             String?
  createdAt         DateTime  @default(now())

  @@index([productId])
}

model ScanLog {
  id        String     @id @default(cuid())
  ean       String
  result    ScanResult
  productId String?
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([ean])
  @@index([createdAt])
}

// Open Food Facts response cache — see .claude/skills/openfoodfacts/SKILL.md.
// Negative results (found = false) are cached too, so a re-scan of a
// not-found barcode doesn't hit OFF again within the TTL.
model OffCache {
  barcode   String   @id
  rawJson   Json?
  found     Boolean
  fetchedAt DateTime @default(now())
}

// Ticket #1369 (website sync): a single row (id always 1) holding this
// install's Cloudflare backend connection. The device key is generated once
// by the owner's own setup script on the backend (scripts/create-device-key.mjs
// in the atg-shop-backend repo) — it lives here, in this install's own
// Postgres, the same trust boundary as the rest of the shop's data.
model ShopSyncSettings {
  id        Int      @id @default(1)
  apiUrl    String?
  deviceId  String?
  deviceKey String?
  updatedAt DateTime @updatedAt
}

// The offline queue ticket #1369 asks for: one row per category/product that
// still needs to reach the backend. Keyed by entityId so repeated saves
// before a drain just overwrite the pending payload instead of growing an
// unbounded queue - see lib/sync/outbox.ts.
model SyncOutbox {
  id         String   @id @default(cuid())
  entityType String
  entityId   String   @unique
  payload    Json
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType])
}

// Mirrors the backend's `orders`/`order_items` tables (atg-shop-backend,
// migrations/0001_init.sql) for the subset the app needs once an order is
// imported - see lib/sync/orders.ts.
model ShopOrder {
  id             String          @id
  status         ShopOrderStatus @default(received)
  customerName   String
  customerPhone  String?
  fulfilmentType String
  totalRappen    Int
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          ShopOrderItem[]
}

model ShopOrderItem {
  id        String     @id @default(cuid())
  orderId   String
  order     ShopOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  nameDe    String
  qty       Int

  @@index([orderId])
}
