{
  "name": "asia-shop",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/postbuild-copy-natives.cjs && node scripts/postbuild-copy-static.cjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts",
    "electron:build-src": "tsc -p electron/tsconfig.json && node scripts/copy-electron-assets.cjs",
    "electron:trim-deps": "node scripts/trim-electron-app-bloat.cjs",
    "electron:dev": "pnpm run electron:build-src && electron electron/app/main.js",
    "icon:generate": "node scripts/generate-icon.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@next/env": "15.5.22",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@swc/helpers": "0.5.15",
    "caniuse-lite": "^1.0.30001806",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "15.5.22",
    "pg": "^8.22.0",
    "postcss": "8.4.31",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "sharp": "^0.35.3",
    "styled-jsx": "5.1.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
