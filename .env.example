# Copy to .env and adjust if needed. Matches a local Postgres instance
# with user/password/db "asia_shop" on the default port.
DATABASE_URL="postgresql://asia_shop:asia_shop@localhost:5432/asia_shop?schema=public"

# Kontaktadresse im User-Agent für Open Food Facts (von OFF vorgeschrieben,
# siehe deren Abuse-Kontakt-Richtlinie). Trage hier eure eigene Adresse ein —
# ohne diese Variable schlägt jeder OFF-Lookup mit einer klaren Fehlermeldung fehl.
OFF_CONTACT_EMAIL="deine-adresse@beispiel.ch"
